// metadata.1c - code of the MCP tool "metadata" (1C 7.7, CP1251). Embedded into 1cmcp.dll as RCDATA;
// the two markers in the main code below are replaced with string literals (kind, name). Result goes to Результат.
Перем ПС, Вид, Имя, Н, К, В, М, Найден, Ид, Текст, МД;

Функция ВидПоНомеру(Н)
	Если Н = 1 Тогда
		Возврат "Справочник";
	ИначеЕсли Н = 2 Тогда
		Возврат "Документ";
	ИначеЕсли Н = 3 Тогда
		Возврат "Регистр";
	ИначеЕсли Н = 4 Тогда
		Возврат "Перечисление";
	ИначеЕсли Н = 5 Тогда
		Возврат "Отчет";
	ИначеЕсли Н = 6 Тогда
		Возврат "Обработка";
	ИначеЕсли Н = 7 Тогда
		Возврат "Журнал";
	КонецЕсли;
	Возврат "Константа";
КонецФункции

Функция Т(Х)
	Возврат СокрЛП(Строка(Х));
КонецФункции

Функция Колво(Вд)
	Перем Н;
	Н = 0;
	Попытка
		Если Вд = "Справочник" Тогда
			Н = Метаданные.Справочник();
		ИначеЕсли Вд = "Документ" Тогда
			Н = Метаданные.Документ();
		ИначеЕсли Вд = "Регистр" Тогда
			Н = Метаданные.Регистр();
		ИначеЕсли Вд = "Перечисление" Тогда
			Н = Метаданные.Перечисление();
		ИначеЕсли Вд = "Отчет" Тогда
			Н = Метаданные.Отчет();
		ИначеЕсли Вд = "Обработка" Тогда
			Н = Метаданные.Обработка();
		ИначеЕсли Вд = "Журнал" Тогда
			Н = Метаданные.Журнал();
		ИначеЕсли Вд = "Константа" Тогда
			Н = Метаданные.Константа();
		КонецЕсли;
	Исключение
		Н = 0;
	КонецПопытки;
	Возврат Н;
КонецФункции

Функция ПолучитьМД(Вд, Н)
	Если Вд = "Справочник" Тогда
		Возврат Метаданные.Справочник(Н);
	ИначеЕсли Вд = "Документ" Тогда
		Возврат Метаданные.Документ(Н);
	ИначеЕсли Вд = "Регистр" Тогда
		Возврат Метаданные.Регистр(Н);
	ИначеЕсли Вд = "Перечисление" Тогда
		Возврат Метаданные.Перечисление(Н);
	ИначеЕсли Вд = "Отчет" Тогда
		Возврат Метаданные.Отчет(Н);
	ИначеЕсли Вд = "Обработка" Тогда
		Возврат Метаданные.Обработка(Н);
	ИначеЕсли Вд = "Журнал" Тогда
		Возврат Метаданные.Журнал(Н);
	ИначеЕсли Вд = "Константа" Тогда
		Возврат Метаданные.Константа(Н);
	КонецЕсли;
	Возврат 0;
КонецФункции

Функция ИдСин(О)
	Перем С, С2;
	С = "";
	Попытка
		С = Т(О.Идентификатор);
	Исключение
		С = "?";
	КонецПопытки;
	С2 = "";
	Попытка
		С2 = Т(О.Синоним);
	Исключение
	КонецПопытки;
	Возврат С + " | " + С2;
КонецФункции

// Описание реквизита/измерения/ресурса/константы (О - объект МД)
Функция ОписатьРк(О)
	Перем С, Х, Тп, Вд2, Дл, Тч;
	С = "    " + ИдСин(О);
	Тп = "";
	Попытка
		Тп = Т(О.Тип);
	Исключение
	КонецПопытки;
	Вд2 = "";
	Попытка
		Вд2 = Т(О.Вид);
	Исключение
	КонецПопытки;
	Дл = 0;
	Попытка
		Дл = О.Длина;
	Исключение
	КонецПопытки;
	Тч = 0;
	Попытка
		Тч = О.Точность;
	Исключение
	КонецПопытки;
	Х = Тп;
	Если Вд2 <> "" Тогда
		Х = Х + "." + Вд2;
	КонецЕсли;
	Если Тп = "Число" Тогда
		Х = Х + "(" + Т(Дл) + "," + Т(Тч) + ")";
	ИначеЕсли Тп = "Строка" Тогда
		Если Дл = 0 Тогда
			Х = Х + "(неогр.)";
		Иначе
			Х = Х + "(" + Т(Дл) + ")";
		КонецЕсли;
	КонецЕсли;
	С = С + " | " + Х;
	Попытка
		Если О.Периодический = 1 Тогда
			С = С + " | Периодический";
		КонецЕсли;
	Исключение
	КонецПопытки;
	Попытка
		Х = Т(О.Комментарий);
		Если Х <> "" Тогда
			С = С + " | // " + Х;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат С + ПС;
КонецФункции

Функция ОбщиеСвойства(О)
	Перем С;
	С = "";
	Попытка
		С = С + "Синоним: " + Т(О.Синоним) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		С = С + "Комментарий: " + Т(О.Комментарий) + ПС;
	Исключение
	КонецПопытки;
	Возврат С;
КонецФункции

Функция ОписатьСправочник(О)
	Перем С, Х, Н, К;
	С = ОбщиеСвойства(О);
	Попытка
		С = С + "ДлинаКода: " + Т(О.ДлинаКода) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		С = С + "ДлинаНаименования: " + Т(О.ДлинаНаименования) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		С = С + "КоличествоУровней: " + Т(О.КоличествоУровней) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		С = С + "ТипКода: " + Т(О.ТипКода) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		Если О.Владелец.Выбран() = 1 Тогда
			С = С + "Владелец: " + Т(О.Владелец.Идентификатор) + ПС;
		КонецЕсли;
	Исключение
		Попытка
			Х = Т(О.Владелец);
			Если Х <> "" Тогда
				С = С + "Владелец: " + Х + ПС;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецПопытки;
	К = 0;
	Попытка
		К = О.Реквизит();
	Исключение
	КонецПопытки;
	С = С + "Реквизиты (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + ОписатьРк(О.Реквизит(Н));
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	Возврат С;
КонецФункции

Функция ОписатьДокумент(О)
	Перем С, Н, К;
	С = ОбщиеСвойства(О);
	Попытка
		С = С + "ДлинаНомера: " + Т(О.ДлинаНомера) + ", ТипНомера: " + Т(О.ТипНомера) + ", ПериодичностьНомера: " + Т(О.ПериодичностьНомера) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		С = С + "Проведение: " + Т(О.РазрешитьПроведение) + ", Оперативный: " + Т(О.ОперативныйУчет) + ", Бухгалтерский: " + Т(О.БухгалтерскийУчет) + ", Расчет: " + Т(О.Расчет) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		С = С + "Журнал: " + Т(О.Журнал.Идентификатор) + ПС;
	Исключение
	КонецПопытки;
	К = 0;
	Попытка
		К = О.РеквизитШапки();
	Исключение
	КонецПопытки;
	С = С + "Реквизиты шапки (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + ОписатьРк(О.РеквизитШапки(Н));
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	К = 0;
	Попытка
		К = О.РеквизитТабличнойЧасти();
	Исключение
	КонецПопытки;
	С = С + "Реквизиты табличной части (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + ОписатьРк(О.РеквизитТабличнойЧасти(Н));
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	Возврат С;
КонецФункции

Функция ОписатьРегистр(О)
	Перем С, Н, К;
	С = ОбщиеСвойства(О);
	Попытка
		С = С + "ТипРегистра: " + Т(О.ТипРегистра) + ПС;
	Исключение
	КонецПопытки;
	Попытка
		С = С + "ПериодичностьРегистра: " + Т(О.ПериодичностьРегистра) + ПС;
	Исключение
	КонецПопытки;
	К = 0;
	Попытка
		К = О.Измерение();
	Исключение
	КонецПопытки;
	С = С + "Измерения (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + ОписатьРк(О.Измерение(Н));
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	К = 0;
	Попытка
		К = О.Ресурс();
	Исключение
	КонецПопытки;
	С = С + "Ресурсы (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + ОписатьРк(О.Ресурс(Н));
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	К = 0;
	Попытка
		К = О.Реквизит();
	Исключение
	КонецПопытки;
	С = С + "Реквизиты (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + ОписатьРк(О.Реквизит(Н));
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	Возврат С;
КонецФункции

Функция ОписатьПеречисление(О)
	Перем С, Н, К, Х, Ж;
	С = ОбщиеСвойства(О);
	К = 0;
	Попытка
		К = О.Значение();
	Исключение
		К = 0;
	КонецПопытки;
	Если К = 0 Тогда
		// запасной вариант: перебор до первой ошибки
		Для Н = 1 По 500 Цикл
			Ж = 0;
			Попытка
				Х = Т(О.Значение(Н).Идентификатор);
				Ж = 1;
			Исключение
			КонецПопытки;
			Если Ж = 0 Тогда
				Прервать;
			КонецЕсли;
			К = Н;
		КонецЦикла;
	КонецЕсли;
	С = С + "Значения (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + "    " + ИдСин(О.Значение(Н));
			Х = Т(О.Значение(Н).Комментарий);
			Если Х <> "" Тогда
				С = С + " | // " + Х;
			КонецЕсли;
			С = С + ПС;
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	Возврат С;
КонецФункции

Функция ОписатьЖурнал(О)
	Перем С, Н, К;
	С = ОбщиеСвойства(О);
	Попытка
		С = С + "ТипЖурнала: " + Т(О.ТипЖурнала) + ПС;
	Исключение
	КонецПопытки;
	К = 0;
	Попытка
		К = О.Графа();
	Исключение
	КонецПопытки;
	С = С + "Графы (" + Т(К) + "):" + ПС;
	Для Н = 1 По К Цикл
		Попытка
			С = С + "    " + ИдСин(О.Графа(Н)) + ПС;
		Исключение
			С = С + "    #" + Т(Н) + " ?" + ПС;
		КонецПопытки;
	КонецЦикла;
	Возврат С;
КонецФункции

Функция ОписатьКонстанту(О)
	Возврат ОбщиеСвойства(О) + "Тип:" + ПС + ОписатьРк(О);
КонецФункции

Функция ОписатьОбъект(Вд, О)
	Если Вд = "Справочник" Тогда
		Возврат ОписатьСправочник(О);
	ИначеЕсли Вд = "Документ" Тогда
		Возврат ОписатьДокумент(О);
	ИначеЕсли Вд = "Регистр" Тогда
		Возврат ОписатьРегистр(О);
	ИначеЕсли Вд = "Перечисление" Тогда
		Возврат ОписатьПеречисление(О);
	ИначеЕсли Вд = "Журнал" Тогда
		Возврат ОписатьЖурнал(О);
	ИначеЕсли Вд = "Константа" Тогда
		Возврат ОписатьКонстанту(О);
	КонецЕсли;
	Возврат ОбщиеСвойства(О);
КонецФункции

// ---------------- основной код ----------------
ПС = РазделительСтрок;
Вид = %ВИД%;
Имя = %ИМЯ%;
// вид без учёта регистра: справочник -> Справочник
Для Н = 1 По 8 Цикл
	В = ВидПоНомеру(Н);
	Если НРег(В) = НРег(СокрЛП(Вид)) Тогда
		Вид = В;
	КонецЕсли;
КонецЦикла;

Если Вид = "" Тогда
	Текст = "Метаданные конфигурации" + ПС;
	Попытка
		Текст = Текст + "Конфигурация: " + Т(Метаданные.Идентификатор) + " | " + Т(Метаданные.Синоним) + ПС;
	Исключение
	КонецПопытки;
	Для Н = 1 По 8 Цикл
		В = ВидПоНомеру(Н);
		К = Колво(В);
		Текст = Текст + ПС + В + " (" + Т(К) + "):" + ПС;
		Для М = 1 По К Цикл
			Попытка
				МД = ПолучитьМД(В, М);
				Текст = Текст + "  " + ИдСин(МД) + ПС;
			Исключение
				Текст = Текст + "  #" + Т(М) + " ?" + ПС;
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Результат = Текст;
Иначе
	К = Колво(Вид);
	Если СокрЛП(Имя) = "" Тогда
		// Вид без Имени - список объектов вида
		Текст = Вид + " (" + Т(К) + "):" + ПС;
		Для М = 1 По К Цикл
			Попытка
				МД = ПолучитьМД(Вид, М);
				Текст = Текст + "  " + ИдСин(МД) + ПС;
			Исключение
			КонецПопытки;
		КонецЦикла;
		Результат = Текст;
	Иначе
		Найден = 0;
		Для М = 1 По К Цикл
			Ид = "";
			Попытка
				МД = ПолучитьМД(Вид, М);
				Ид = Т(МД.Идентификатор);
			Исключение
			КонецПопытки;
			Если НРег(Ид) = НРег(СокрЛП(Имя)) Тогда
				Найден = М;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Найден = 0 Тогда
			Результат = "Объект не найден: " + Вид + "." + Имя;
		Иначе
			МД = ПолучитьМД(Вид, Найден);
			Результат = Вид + "." + Ид + ПС + ОписатьОбъект(Вид, МД);
		КонецЕсли;
	КонецЕсли;
КонецЕсли;
