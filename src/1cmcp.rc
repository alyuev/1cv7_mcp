#include <windows.h>
#include <winver.h>
#include "resource.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,1
 PRODUCTVERSION 0,2,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904e3"
        BEGIN
            VALUE "FileDescription", "1cmcp - MCP server for 1C:Enterprise 7.7 (0.2.0.1)\0"
            VALUE "FileVersion", "0,2,0,1\0"
            VALUE "InternalName", "1cmcp.dll\0"
            VALUE "OriginalFilename", "1cmcp.dll\0"
            VALUE "ProductName", "1cmcp\0"
            VALUE "ProductVersion", "0.2.0.1\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1251
    END
END

STRINGTABLE DISCARDABLE
BEGIN
    100 "\0sd"
END

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
#pragma code_page(1251)

IDD_MCP_PAGE DIALOG DISCARDABLE  0, 0, 262, 226
STYLE DS_CONTROL | DS_3DLOOK | WS_CHILD
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Сервер MCP для ИИ-агентов",-1,4,2,254,112
    LTEXT           "Порт:",-1,10,17,24,8
    EDITTEXT        IDC_PORT,36,15,36,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Адрес:",-1,82,17,26,8
    EDITTEXT        IDC_ADDR,110,15,140,12,ES_AUTOHSCROLL
    LTEXT           "Токен:",-1,10,33,24,8
    EDITTEXT        IDC_TOKEN,36,31,214,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Сгенерировать",IDC_GEN,36,47,62,14
    PUSHBUTTON      "Копировать токен",IDC_COPY,102,47,72,14
    CONTROL         "Разрешить выполнение кода 1С (eval, run_code)",IDC_ALLOWCODE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,67,240,10
    CONTROL         "Запускать сервер при загрузке компоненты",IDC_AUTOSTART,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,80,240,10
    LTEXT           "Адрес 127.0.0.1 - только эта машина. Без токена сервер работает только на 127.0.0.1.",
                    -1,10,94,240,16
    GROUPBOX        "Состояние",-1,4,118,254,88
    LTEXT           "",IDC_STATUS,10,130,240,48
    PUSHBUTTON      "Запустить",IDC_STARTSTOP,10,184,62,14
    PUSHBUTTON      "Копировать команду для Claude Code",IDC_COPYCMD,78,184,136,14
    LTEXT           "",IDC_INIPATH,6,210,252,12
END
