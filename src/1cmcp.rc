#include <windows.h>
#include <winver.h>
#include "resource.h"
#include "mcp_version.h"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION MCP_VERSION_RC
 PRODUCTVERSION MCP_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904e3"
        BEGIN
            VALUE "FileDescription", "1cmcp - MCP server for 1C:Enterprise 7.7\0"
            VALUE "FileVersion", MCP_VERSION_FULL
            VALUE "InternalName", "1cmcp.dll\0"
            VALUE "OriginalFilename", "1cmcp.dll\0"
            VALUE "ProductName", "1cmcp\0"
            VALUE "ProductVersion", MCP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1251
    END
END

STRINGTABLE DISCARDABLE
BEGIN
    100 "\0sd"
END

LANGUAGE LANG_RUSSIAN, SUBLANG_DEFAULT
#pragma code_page(1251)

IDD_MCP_PAGE DIALOG DISCARDABLE  0, 0, 262, 270
STYLE DS_CONTROL | DS_3DLOOK | WS_CHILD
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX        "Сервер MCP для ИИ-агентов",-1,4,2,254,150
    LTEXT           "Порт:",-1,10,17,24,8
    EDITTEXT        IDC_PORT,36,15,36,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Адрес:",-1,82,17,26,8
    EDITTEXT        IDC_ADDR,110,15,140,12,ES_AUTOHSCROLL
    LTEXT           "Токен:",-1,10,33,24,8
    EDITTEXT        IDC_TOKEN,36,31,214,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Сгенерировать",IDC_GEN,36,47,62,14
    PUSHBUTTON      "Копировать токен",IDC_COPY,102,47,72,14
    CONTROL         "Разрешить выполнение кода 1С (eval, run_code)",IDC_ALLOWCODE,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,67,240,10
    CONTROL         "Запускать сервер при загрузке компоненты",IDC_AUTOSTART,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,80,240,10
    CONTROL         "Подсвечивать действия ИИ на формах (рамка вокруг элемента)",IDC_HIGHLIGHT,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,93,240,10
    CONTROL         "Показывать действия ИИ в отдельном окне сообщений",IDC_ACTIONWIN,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,106,240,10
    LTEXT           "Журнал:",IDC_LOGLABEL,10,122,28,8
    EDITTEXT        IDC_LOGFILE,40,120,192,12,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_LOGBROWSE,234,119,16,14
    LTEXT           "Файл журнала вызовов (пользователь, сеанс, параметры). Пусто - SYSLOG\\1cmcp.log базы; можно папку.",
                    -1,10,135,240,16
    GROUPBOX        "Состояние",IDC_VERSION,4,156,254,76
    LTEXT           "",IDC_STATUS,10,167,240,40
    PUSHBUTTON      "Запустить",IDC_STARTSTOP,10,212,62,14
    PUSHBUTTON      "Копировать команду для Claude Code",IDC_COPYCMD,78,212,136,14
    LTEXT           "",IDC_INIPATH,6,236,252,30
END

// code of the MCP tool "metadata" (1C 7.7 module text, CP1251)
METADATA1C RCDATA "metadata.1c"
